# Copier ce fichier en .env puis adapter les valeurs
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://boutique:boutique@localhost:55432/boutique
# Base dédiée aux tests d'intégration (elle est réinitialisée à chaque lancement)
TEST_DATABASE_URL=postgresql://boutique:boutique@localhost:55432/boutique_test
# Générer une valeur longue et aléatoire : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
CLIENT_URL=http://localhost:5180
# Nombre de proxies devant l'API (1 en local / Nginx, 2 derrière Vercel + Railway)
TRUST_PROXY=1
